FROM elasticsearch:9.4.2
LABEL maintainer="chenbz35@dimpt.com"
USER root

# 1. 设置时区
# 2. 安装插件 (root权限安装，默认生成的文件就是 0:0)
# 3. 核心：全部设为 0:0，并确保组(Group)有写入权
# 这样无论容器以 UID 1000 还是随机 UID 启动，只要它在 GID 0 里就能跑
ENV TZ=Asia/Shanghai
RUN microdnf update -y && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    ./bin/elasticsearch-plugin install --batch https://release.infinilabs.com/analysis-ik/stable/elasticsearch-analysis-ik-9.4.2.zip && \
    ./bin/elasticsearch-plugin install --batch https://release.infinilabs.com/analysis-pinyin/stable/elasticsearch-analysis-pinyin-9.4.2.zip && \
    chown -R 0:0 /usr/share/elasticsearch && \
    chmod -R g+rwX /usr/share/elasticsearch

# 切回用户
USER 1000:0