<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.platform.docker</groupId>
    <artifactId>docker-images</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <docker-maven-version>0.48.0</docker-maven-version>
        <docker.platforms>linux/amd64,linux/arm64</docker.platforms>
        <platform.docker.tag>latest</platform.docker.tag>
    </properties>

    <modules>
        <module>mysql</module>
        <module>teamcity-server</module>
        <module>teamcity-agent</module>
        <module>alpine-dnsmasq</module>
        <module>alpine-docker</module>
        <module>alpine-python</module>
        <module>alpine-jdk17</module>
        <module>alpine-jre11</module>
        <module>alpine-jre17</module>
        <module>openj9-jdk17</module>
        <module>openj9-jre17</module>
        <module>alpine-jdk21</module>
        <module>alpine-jre21</module>
        <module>alpine-jdk25</module>
        <module>alpine-nodejs-24</module>
        <module>alpine-nodejs-20</module>
        <module>alpine-redis</module>
        <module>alpine-redis8</module>
        <module>alpine-nginx</module>
        <module>alpine-zookeeper</module>
        <module>alpine-sshd</module>
        <module>alpine-openresty</module>
        <module>jenkins</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.fabric8</groupId>
                    <artifactId>docker-maven-plugin</artifactId>
                    <version>${docker-maven-version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.3</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>releases</id>
            <name>Releases</name>
            <url>${releases.url}</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>Snapshot</name>
            <url>${snapshots.url}</url>
        </snapshotRepository>
    </distributionManagement>
</project>